<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PDFReader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.PDFReader.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0C12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_pdf</item>
        <item name="postSplashScreenTheme">@style/Theme.PDFReader</item>
    </style>
</resources>
