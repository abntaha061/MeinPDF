<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="pdf_reader_db" />
        <exclude domain="cache" path="." />
        <exclude domain="database" path="pdf_reader_db-shm" />
        <exclude domain="database" path="pdf_reader_db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="pdf_reader_db" />
    </device-transfer>
</data-extraction-rules>
